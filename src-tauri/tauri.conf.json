{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "video-distiller",
  "version": "0.0.1",
  "identifier": "com.local.videodistiller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "抖音视频核心提炼",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/yt-dlp",
      "binaries/whisper-cli"
    ],
    "resources": {
      "ggml-base.dll": "ggml-base.dll",
      "ggml-cpu.dll": "ggml-cpu.dll",
      "ggml.dll": "ggml.dll",
      "whisper.dll": "whisper.dll"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
